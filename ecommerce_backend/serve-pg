#!/bin/bash
# Wrapper to run Laravel dev server with PostgreSQL + intl extensions loaded.
# Uses a local php.ini so all spawned PHP worker processes inherit the extensions.
# Usage: ./serve-pg [host:port]
# Default: 127.0.0.1:8000

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PHP_INI="$SCRIPT_DIR/php.ini"
HOST_PORT="${1:-127.0.0.1:8000}"

export PHP_INI_SCAN_DIR=""
exec php -c "$PHP_INI" artisan serve --host="${HOST_PORT%:*}" --port="${HOST_PORT#*:}"
